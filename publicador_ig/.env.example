# ---- Banco / fila -------------------------------------------------------
DATABASE_URL="postgresql://user:pass@localhost:5432/publicador_ig?schema=public"
REDIS_URL="redis://127.0.0.1:6379"

# ---- App ---------------------------------------------------------------
APP_URL="http://localhost:3000"
AUTH_SECRET=""
# 32 bytes em hex (openssl rand -hex 32) - cifra os tokens da Meta em repouso
APP_ENCRYPTION_KEY=""

# ---- Meta / Instagram --------------------------------------------------
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_VERSION="v23.0"
# Em dev sem app aprovado, "mock" simula a publicacao sem chamar a Meta.
META_DRIVER="mock"

# ---- Storage de midia --------------------------------------------------
# local | s3
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
# A Meta precisa baixar a midia por HTTP publico. Em dev, use um tunel
# (cloudflared/ngrok) e aponte PUBLIC_MEDIA_BASE_URL para ele.
PUBLIC_MEDIA_BASE_URL="http://localhost:3000/media"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
