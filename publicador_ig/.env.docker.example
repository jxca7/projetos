# Segredos do docker-compose. Copie para .env.docker e preencha.
# Gere os dois primeiros com:
#   openssl rand -base64 32    (AUTH_SECRET)
#   openssl rand -hex 32       (APP_ENCRYPTION_KEY)

POSTGRES_PASSWORD="troque-esta-senha-do-banco"

# Dentro do compose, o banco e o redis são alcançados pelo nome do serviço.
DATABASE_URL="postgresql://publicador:troque-esta-senha-do-banco@db:5432/publicador_ig?schema=public"
REDIS_URL="redis://redis:6379"

# URL pública por onde as pessoas e a Meta acessam. Em VPS, o domínio/IP real.
APP_URL="https://seu-dominio.com"

AUTH_SECRET=""
APP_ENCRYPTION_KEY=""

# "mock" não toca a Meta. "graph" publica de verdade.
META_DRIVER="graph"
META_GRAPH_VERSION="v23.0"
META_APP_ID=""
META_APP_SECRET=""

# A Meta baixa a mídia por HTTP público. Para produção de verdade, use S3/R2:
#   STORAGE_DRIVER="s3" e preencha as chaves abaixo + PUBLIC_MEDIA_BASE_URL.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
PUBLIC_MEDIA_BASE_URL="https://seu-dominio.com/media"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
